{
    "name": "jmf/grid-bundle",
    "description": "Grid bundle for Symfony",
    "license": "mit",
    "type": "symfony-bundle",
    "require": {
        "php": ">=8.3",
        "jmf/preset-rendering-bundle": "1.0.x-dev",
        "jmf/template-rendering": "2.0.x-dev",
        "symfony/config": "^7.0",
        "symfony/framework-bundle": "^7.0",
        "symfony/property-access": "^7.0",
        "webmozart/assert": "^1.0"
    },
    "require-dev": {
        "phpmd/phpmd": "^2.10",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.1",
        "rector/rector": "^2.0",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Jmf\\Grid\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jmf\\Grid\\Tests\\": "tests"
        }
    }
}
