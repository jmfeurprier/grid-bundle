{
    "name": "jmf/grid-bundle",
    "description": "Grid bundle for Symfony",
    "license": "mit",
    "type": "symfony-bundle",
    "require": {
        "php": ">=8.3",
        "jmf/rendering-preset-bundle": "^1.0",
        "jmf/template-rendering": "^2.0",
        "symfony/config": "^7.0|^8.0",
        "symfony/framework-bundle": "^7.0|^8.0",
        "symfony/property-access": "^7.0|^8.0",
        "webmozart/assert": "^1.0|^2.0"
    },
    "require-dev": {
        "overtrue/phplint": "^9.7.1",
        "phpstan/phpstan": "^2.1.33",
        "phpstan/phpstan-strict-rules": "^2.0.7",
        "phpunit/phpunit": "^12.5.4",
        "rector/rector": "^2.3.0",
        "squizlabs/php_codesniffer": "^4.0.1"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Jmf\\Grid\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jmf\\Grid\\Tests\\": "tests/src"
        }
    }
}
