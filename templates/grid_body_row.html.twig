{% set attributes = row.attributes %}
{% if row.link is not null %}
    {% set attributes = attributes|merge({
        'onclick': "window.location='" ~ row.link ~ "'",
        'style':   'cursor:pointer',
    }) %}
{% endif %}
<tr{% for attribute, value in attributes %} {{ attribute }}="{{ value }}"{% endfor %}>
    {% for cell in row.cells %}
        {{ include('@JmfGrid/grid_body_row_cell.html.twig') }}
    {% endfor %}
</tr>
